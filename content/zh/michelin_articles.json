    "practicalInfo": {
      "name": "頤宮中餐廳 Le Palais（君品酒店 17 樓）",
      "address": "台北市大同區承德路一段 3 號 17 樓",
      "businessHours": "午餐 11:30–14:30 ｜ 晚餐 17:30–21:30",
      "phone": "+886-2-2181-9985",
      "transport": "台北車站步行 3 分鐘／捷運中山站步行 6 分鐘",
      "mapUrl": "https://maps.google.com/?q=頤宮中餐廳+Le+Palais"
    },
    "bookingUrl": "https://www.palaisdechinehotel.com/tw/restaurant-info.php?id=6",
    "editorialNote": "依 PM 設計稿建立的範例；圖片非餐廳實拍，價格、菜單與訂位規則尚待查核。",
    "source": {
      "file": "米其林餐廳/01-mi.html",
      "language": "zh",
      "sha256": "c793c177fa67349041a4ab07452aa7d03cdb73ae48f26b6d3956c92909a1f41e",
      "awardThroughYear": 2025,
      "imageUsage": "design-illustrations",
      "guideOriginals": {
        "guide_1": {
          "en": {
            "heading": "Can I wear shorts, sneakers, or flip-flops?",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Smart Casual is strictly required."
                      }
                    ]
                  },
                  {
                    "text": " Gentlemen must wear long trousers and closed-toe shoes (clean leather sneakers or loafers are acceptable). "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Strictly NO shorts, sleeveless shirts/tank tops, flip-flops, or slippers"
                      }
                    ]
                  },
                  {
                    "text": "—guests in violation may be refused entry."
                  }
                ]
              }
            ]
          },
          "ja": {
            "heading": "短パン・スニーカー・サンダルでの入店は可能ですか？",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "スマートカジュアル必須です。"
                      }
                    ]
                  },
                  {
                    "text": "男性は長ズボンとつま先の隠れる靴（清潔感のあるスニーカーや革靴は可）をご着用ください。"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "短パン、タンクトップ、ビーチサンダル、スリッパでの入店は固くお断り"
                      }
                    ]
                  },
                  {
                    "text": "しております。"
                  }
                ]
              }
            ]
          }
        },
        "guide_2": {
          "en": {
            "heading": "How far in advance do reservations open?",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "Online reservations open "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "1 to 2 months in advance"
                      }
                    ]
                  },
                  {
                    "text": " (on the 1st of each month for the following month). A credit card deposit is required to secure your table. Weekend dinners book out within minutes—reserve early."
                  }
                ]
              }
            ]
          },
          "ja": {
            "heading": "何ヶ月前から予約ができますか？",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "オンライン予約は"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "1〜2ヶ月前（毎月1日に翌月分）"
                      }
                    ]
                  },
                  {
                    "text": "より受付開始となります。予約確定にはクレジットカードのデポジット登録が必要です。週末のディナーは即満席となるためお早めにご予約ください。"
                  }
                ]
              }
            ]
          }
        },
        "guide_3": {
          "en": {
            "heading": "Are vegetarian or beef-free menus available?",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Yes."
                      }
                    ]
                  },
                  {
                    "text": " Le Palais offers dedicated "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Vegetarian Set Menus"
                      }
                    ]
                  },
                  {
                    "text": " and accommodates beef-free, pork-free, or shellfish allergy requests. Please specify your dietary requirements at least "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "3 days prior"
                      }
                    ]
                  },
                  {
                    "text": " to your visit."
                  }
                ]
              }
            ]
          },
          "ja": {
            "heading": "ベジタリアンや牛肉NGの対応メニューはありますか？",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "はい、対応可能です。"
                      }
                    ]
                  },
                  {
                    "text": "専用のベジタリアンコースのほか、牛肉・豚肉抜きや甲殻類アレルギーにも柔軟に対応いたします。食材の変更は"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "ご来店の3日前まで"
                      }
                    ]
                  },
                  {
                    "text": "に必ず事前にお知らせください。"
                  }
                ]
              }
            ]
          }
        },
        "guide_4": {
          "en": {
            "heading": "What are the must-order signature dishes?",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "The legendary "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Flambé Roast Peking Duck"
                      }
                    ]
                  },
                  {
                    "text": " and "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "Crispy Roasted Baby Duck"
                      }
                    ]
                  },
                  {
                    "text": " are absolute musts—both "
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "must be pre-ordered when booking"
                      }
                    ]
                  },
                  {
                    "text": ". For lunch, do not miss the Crispy Shrimp Rice Noodle Roll and Honey-Glazed BBQ Pork."
                  }
                ]
              }
            ]
          },
          "ja": {
            "heading": "絶対に注文すべき看板メニューは何ですか？",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "名物の"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "「ファイヤー北京ダック」"
                      }
                    ]
                  },
                  {
                    "text": "と"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "「先知鴨（若鴨の丸焼き）」"
                      }
                    ]
                  },
                  {
                    "text": "は必食ですが、"
                  },
                  {
                    "tag": "strong",
                    "children": [
                      {
                        "text": "予約時の事前注文が必須"
                      }
                    ]
                  },
                  {
                    "text": "です。ランチタイムなら「春風得意腸（海老入り紅米腸粉）」と「極上蜜汁チャーシュー」も外せません。"
                  }
                ]
              }
            ]
          }
        },
        "guide_5": {
          "en": {
            "heading": "Celebrating a Birthday or Special Anniversary?",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "Inform the restaurant in advance if you are celebrating a birthday or anniversary. Complimentary longevity peach buns ("
                  },
                  {
                    "tag": "em",
                    "children": [
                      {
                        "text": "Shou Tao"
                      }
                    ]
                  },
                  {
                    "text": ") or a personalized dessert plate can be arranged. Private dining rooms with minimum spend are also available for family milestones (corkage fee applies for outside wine/liquor)."
                  }
                ]
              }
            ]
          },
          "ja": {
            "heading": "誕生日や結婚記念日のお祝いサービスはありますか？",
            "blocks": [
              {
                "tag": "p",
                "children": [
                  {
                    "text": "ご予約時にお誕生日や記念日利用の旨をお伝えいただくと、お祝いの桃まんじゅう（壽桃）やメッセージ付きデザートプレートのご用意が可能です。ご家族での大切な節目には、ミニマムチャージ制の個室（全席禁煙・お酒の持ち込みは抜栓料あり）もご利用いただけます。"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "translation": {
      "status": "source",
      "sourceLanguage": "zh"
    }
  }
